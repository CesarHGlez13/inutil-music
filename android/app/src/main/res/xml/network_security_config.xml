<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- La sincronización tipo Spotify-Connect habla HTTP plano contra la IP
         del PC de la red local. Esa IP cambia en cada red y Android no admite
         rangos/CIDR en <domain>, así que el cleartext se permite de base;
         todo el tráfico con Google, YouTube Music y Firebase sigue por HTTPS.
         El endpoint loopback del arte de las notificaciones también depende de
         este permiso. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Host del emulador de Android que apunta a la máquina física. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
