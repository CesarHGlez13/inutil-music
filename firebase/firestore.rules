rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------
    // Modelo de seguridad de INÚTIL MUSIC (v3)
    //
    //   * La identidad la pone Firebase Auth; el ROL y la LICENCIA viven en
    //     el documento users/{uid} y solo un admin puede mutar los campos
    //     protegidos. Conocer el correo del fundador no es una credencial:
    //     Firebase Auth sigue exigiendo la contraseña.
    //   * Los campos de licencia (role/status/isActive/accountExpiresAt/
    //     accountDurationDays) son inmutables para el propio usuario: un
    //     cliente manipulado no puede autoconcederse vigencia.
    //   * El teléfono y el registro de cambios de teléfono sí los puede
    //     escribir el propio usuario (su cliente legítimo los gestiona), pero
    //     el contador solo puede crecer dentro del mismo mes. En producción
    //     estos movimientos deberían hacerlos Cloud Functions.
    // ------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (isBootstrapAdminIdentity() ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Correos del fundador: único caso en que el propio usuario puede
    // sembrar/elevar su documento a rol admin (su identidad ya la validó
    // Firebase Auth o Google Sign-In).
    function isBootstrapAdminIdentity() {
      return isSignedIn() &&
        request.auth.token.email in [
          'cesar@inutilmusic.com',
          'humbertoglez96@gmail.com',
          'cesarmaster133@gmail.com'
        ];
    }

    // Campos que el usuario jamás puede cambiar en su propio documento.
    function licenseFieldsUnchanged() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          'role', 'status', 'isActive', 'accountExpiresAt',
          'accountDurationDays', 'phoneSwitchCount', 'phoneSwitchMonth',
          'inactivityExempt'
        ]);
    }

    // El cliente legítimo puede mover su teléfono y su validación, siempre
    // que el contador de cambios no retroceda dentro del mismo mes.
    function phoneBookkeepingAllowed() {
      return request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['currentPhoneDeviceId', 'lastValidatedAt',
                    'phoneSwitchCount', 'phoneSwitchMonth']) &&
        (request.resource.data.phoneSwitchMonth != resource.data.phoneSwitchMonth ||
         request.resource.data.phoneSwitchCount >= resource.data.phoneSwitchCount);
    }

    // Al crear su documento, el usuario normal se limita a rol user y estado
    // pending/active; el rol admin solo para la identidad fundadora.
    function isSelfSeed(userId) {
      return isSelf(userId) &&
        (request.resource.data.role == 'user' ||
         (request.resource.data.role == 'admin' && isBootstrapAdminIdentity())) &&
        request.resource.data.status in ['pending', 'active'];
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      allow create: if isSelfSeed(userId) || isAdmin();

      allow update: if isAdmin() ||
                    (isSelf(userId) && licenseFieldsUnchanged()) ||
                    (isSelf(userId) && phoneBookkeepingAllowed()) ||
                    (isBootstrapAdminIdentity() &&
                     resource.data.role != 'admin' &&
                     request.resource.data.role == 'admin');

      // Solo el admin borra cuentas (el cliente nunca borra perfiles).
      allow delete: if isAdmin();

      // Respaldo en la nube: playlists, biblioteca y ajustes.
      match /data/{itemId} {
        allow read, write: if isSelf(userId) || isAdmin();
      }

      // Subcolecciones heredadas (favoritos/historial por pista).
      match /{sub}/{item} {
        allow read, write: if isSelf(userId) || isAdmin();
      }
    }

    // Manifiesto de versión OTA: lectura pública para que la app pueda
    // comprobar su versión sin sesión; escritura solo para admins.
    match /app_config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Vinculación temporal de Smart TV por código QR cifrado extremo a extremo.
    // - La clave secreta AES-256 solo viaja dentro de la imagen QR (nunca en Firestore).
    // - `allow list: if false` impide enumerar sesiones activas.
    // - Solo un usuario autenticado desde el celular puede aprobar (`pending` -> `approved`).
    match /tv_pairing/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.status == 'pending' &&
                    request.resource.data.keys().hasOnly([
                      'status', 'deviceId', 'deviceName', 'createdAt', 'expiresAt'
                    ]);
      allow update: if isSignedIn() &&
                    resource.data.status == 'pending' &&
                    request.resource.data.status == 'approved';
      // Cerrado el hueco DoS medido el 2026-11-20: con `delete: if true` un
      // cliente anónimo podía borrar un código YA `approved` antes de que la
      // TV lo leyera, y el emparejamiento se caía sin más. Ahora lo borra el
      // dueño autenticado, o el cliente anónimo **mientras el código sigue
      // vivo**, que es justo cuando `cleanupTvSession()` corre (inmediatamente
      // después de leer el sobre, dentro del TTL).
      allow delete: if isSignedIn() || request.time < resource.data.expiresAt;
    }

    // Vinculación temporal de la app de escritorio (PC) por código QR cifrado
    // extremo a extremo. Mismo modelo que `tv_pairing`: la clave AES-256 solo
    // viaja en la imagen QR (o se deriva del código manual de 8 caracteres).
    match /music_pairing/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.resource.data.status == 'pending' &&
                    request.resource.data.keys().hasOnly([
                      'status', 'deviceId', 'deviceName', 'createdAt', 'expiresAt'
                    ]);
      allow update: if isSignedIn() &&
                    resource.data.status == 'pending' &&
                    request.resource.data.status == 'approved';
      // Mismo criterio que `tv_pairing` (comentario arriba). Un detalle extra
      // aquí: el PC escribía `expiresAt` como string de epoch-millis, así que
      // esta comparación contra `request.time` habría dado error de tipos y
      // denegado todo. `pc_client/main.py` lo escribe ahora como
      // `timestampValue` real para que las dos apps hablen el mismo tipo.
      allow delete: if isSignedIn() || request.time < resource.data.expiresAt;
    }
  }
}
