#!/bin/sh
# Lanzador empaquetado en /usr/bin. El bundle vive en /opt/bstream-music y su
# ejecutable tiene el nombre legible que muestran los controles de volumen de
# KDE/PipeWire («Inútil Music»); se conservan también los nombres heredados de
# BStream por si el bundle instalado todavía los usa.
base=/opt/bstream-music
for candidate in "Inútil Music" "BStream Music" "inutil_music" "bstream_music"; do
  if [ -x "$base/$candidate" ]; then
    exec "$base/$candidate" "$@"
  fi
done
echo "No se encontró el ejecutable de Inútil Music en $base" >&2
exit 1
